        {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "unstock_farm_shop"
