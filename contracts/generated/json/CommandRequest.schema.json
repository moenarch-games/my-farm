        {
          "type": "object",
          "properties": {
            "crop_id": {
              "type": "string"
            },
            "plot_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "plant_crop"
            }
          },
          "required": [
            "type",
            "plot_id",
            "crop_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "plot_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "harvest_crop"
            }
          },
          "required": [
            "type",
            "plot_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "recipe_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "start_oven_recipe"
