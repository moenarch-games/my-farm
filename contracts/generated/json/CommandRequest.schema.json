  "properties": {
    "command": {
      "$ref": "#/$defs/FarmCommand"
    },
    "expected_version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "expected_version",
    "command"
  ],
  "$defs": {
    "ConcreteInput": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/ConcreteInputSource"
        }
      },
      "required": [
        "item_id",
        "quantity",
        "source"
      ]
    },
    "ConcreteInputSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stored"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "chain_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "job_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "producer_output"
            }
          },
          "required": [
            "type",
            "job_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "resident_id": {
              "type": "string"
            },
            "task_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "committed_task_output"
            }
          },
          "required": [
            "type",
            "resident_id",
            "task_id"
          ]
        }
      ]
    },
    "ConcreteJobRequest": {
      "type": "object",
      "properties": {
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConcreteInput"
          }
        },
        "resident_id": {
          "type": "string"
        },
        "work": {
          "$ref": "#/$defs/ConcreteWork"
        }
      },
      "required": [
        "id",
        "resident_id",
        "work",
        "after",
        "inputs"
      ]
    },
    "ConcreteWork": {
