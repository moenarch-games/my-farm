          "required": [
            "type",
            "plot_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "harvest_mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SweepHarvestMode"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "plot_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "sweep_harvest"
            }
          },
          "required": [
            "type",
            "plot_ids"
          ]
        },
        {
          "type": "object",
