    {
      "type": "object",
      "properties": {
        "base_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "sale_chance_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "shop_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "farm_shop_visit_rejected"
        }
      },
      "required": [
        "type",
        "item_id",
        "shop_price",
        "base_price",
        "sale_chance_bps"
      ]
