    {
      "type": "object",
      "properties": {
        "decoration_id": {
          "type": "string"
        },
        "placement_id": {
          "type": "string"
        },
        "room_id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/$defs/RoomTile"
        },
        "type": {
          "type": "string",
          "const": "decoration_placed"
        }
      },
      "required": [
        "type",
        "room_id",
        "placement_id",
        "decoration_id",
        "tile"
      ]
    },
    {
      "type": "object",
      "properties": {
        "placement_id": {
          "type": "string"
        },
        "room_id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/$defs/RoomTile"
        },
        "type": {
          "type": "string",
          "const": "decoration_moved"
        }
      },
      "required": [
        "type",
        "room_id",
        "placement_id",
        "tile"
      ]
    },
    {
      "type": "object",
      "properties": {
        "placement_id": {
          "type": "string"
        },
        "room_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "decoration_removed"
        }
      },
      "required": [
        "type",
        "room_id",
        "placement_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "level_changed"
        }
      },
      "required": [
        "type",
        "level"
      ]
    }
