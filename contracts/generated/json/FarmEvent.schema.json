    {
      "type": "object",
      "properties": {
        "crop_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "crop_harvested"
        }
      },
      "required": [
        "type",
        "crop_id",
        "quantity"
      ]
    },
    {
      "type": "object",
      "properties": {
